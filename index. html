<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>NEXORA AI | Intelligent Decision Support</title>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdn.jsdelivr.net/npm/papaparse@5.4.1/papaparse.min.js"></script>

<style>
:root {
  --bg: #080b16;
  --panel: #111729;
  --border: #252e46;
  --text: #f4f7ff;
  --muted: #9aa8c4;
  --cyan: #53e5ff;
  --purple: #9d7bff;
  --green: #52e0a0;
}
* { box-sizing: border-box; }
body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font-family: Inter, Arial, sans-serif;
}
button, input, select { font: inherit; }
button { cursor: pointer; }
.app { display: flex; min-height: 100vh; }
.sidebar {
  width: 245px;
  padding: 28px 18px;
  background: #0c1020;
  border-right: 1px solid var(--border);
  flex-shrink: 0;
}
.logo {
  font-size: 25px;
  font-weight: 900;
  letter-spacing: 2px;
  color: var(--cyan);
}
.logo span { color: var(--purple); }
.tagline {
  color: var(--muted);
  font-size: 11px;
  margin: 9px 0 35px;
}
.nav-btn {
  width: 100%;
  display: block;
  text-align: left;
  padding: 13px 14px;
  border: 0;
  color: var(--muted);
  background: transparent;
  border-radius: 9px;
  margin: 5px 0;
}
.nav-btn:hover, .nav-btn.active {
  background: #1b2540;
  color: var(--cyan);
}
.main { flex: 1; min-width: 0; padding: 30px; }
.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 15px;
  margin-bottom: 28px;
}
h1 { margin: 0 0 8px; font-size: clamp(24px, 3vw, 34px); }
h2 { font-size: 18px; margin-top: 0; }
p { color: var(--muted); line-height: 1.6; }
.badge {
  border: 1px solid #245849;
  color: var(--green);
  background: #102a27;
  border-radius: 30px;
  padding: 8px 12px;
  font-size: 12px;
}
.grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0,1fr));
  gap: 16px;
  margin-bottom: 20px;
}
.card {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 15px;
  padding: 22px;
  min-width: 0;
}
.metric-label { color: var(--muted); font-size: 13px; }
.metric {
  font-size: 30px;
  font-weight: 800;
  margin: 13px 0 6px;
}
.metric-note { color: var(--cyan); font-size: 12px; }
.content-grid {
  display: grid;
  grid-template-columns: 1.5fr 1fr;
  gap: 18px;
  margin-bottom: 20px;
}
.chart-box { height: 270px; position: relative; }
.upload-area {
  border: 1px dashed #53678e;
  border-radius: 13px;
  padding: 26px 16px;
  text-align: center;
  background: #10182a;
}
.upload-area input { max-width: 100%; margin-top: 15px; }
.primary {
  background: linear-gradient(100deg, #4adff5, #9a7bff);
  color: #07101e;
  font-weight: 800;
  padding: 12px 17px;
  border: 0;
  border-radius: 9px;
}
.secondary {
  background: #202a43;
  color: var(--text);
  padding: 11px 15px;
  border: 1px solid var(--border);
  border-radius: 9px;
}
.actions { display: flex; flex-wrap: wrap; gap: 10px; margin: 15px 0; }
.table-wrap { overflow: auto; max-height: 380px; }
table { width: 100%; border-collapse: collapse; font-size: 13px; }
th, td {
  text-align: left;
  padding: 12px;
  border-bottom: 1px solid var(--border);
  white-space: nowrap;
}
th { color: var(--cyan); background: #151e33; position: sticky; top: 0; }
.insight {
  border-left: 3px solid var(--cyan);
  background: #151e31;
  border-radius: 6px;
  padding: 13px 15px;
  margin: 10px 0;
  color: #dce6ff;
  line-height: 1.6;
}
.section { display: none; }
.section.active { display: block; }
select, input[type="text"] {
  padding: 10px;
  border: 1px solid var(--border);
  border-radius: 8px;
  background: #0c1222;
  color: var(--text);
  max-width: 100%;
}
.small { font-size: 12px; color: var(--muted); }
footer { padding: 22px 0; color: var(--muted); font-size: 12px; }
.menu { display: none; }
@media(max-width:1050px) {
  .grid { grid-template-columns: repeat(2,minmax(0,1fr)); }
  .content-grid { grid-template-columns: 1fr; }
}
@media(max-width:700px) {
  .app { display: block; }
  .sidebar { width: 100%; padding: 15px; }
  .tagline { margin: 5px 0 12px; }
  .nav { display: flex; overflow-x: auto; gap: 5px; }
  .nav-btn { width: auto; white-space: nowrap; margin: 0; }
  .main { padding: 18px 13px; }
  .grid { gap: 10px; }
  .card { padding: 15px; }
  .metric { font-size: 23px; }
  .badge { display: none; }
}
</style>
</head>

<body>
<div class="app">

<aside class="sidebar">
  <div class="logo">NEXORA<span> AI</span></div>
  <div class="tagline">INTELLIGENT DECISION SUPPORT</div>

  <nav class="nav">
    <button class="nav-btn active" data-page="dashboard">◈ Dashboard</button>
    <button class="nav-btn" data-page="analysis">▦ Data Analysis</button>
    <button class="nav-btn" data-page="insights">✧ AI Insights</button>
    <button class="nav-btn" data-page="prediction">⌁ Prediction Studio</button>
    <button class="nav-btn" data-page="reports">▤ Reports</button>
  </nav>

  <p class="small" style="margin-top:35px">
    DATA-DRIVEN DECISIONS<br>
    <span style="color:var(--cyan)">● Local Demo Mode</span>
  </p>
</aside>

<main class="main">
  <header class="topbar">
    <div>
      <h1 id="pageTitle">Intelligence Dashboard</h1>
