<script>
"use strict";

const sampleCSV = `Student,StudyHours,Attendance,Assignments,Score
Student 1,2,65,5,48
Student 2,3,70,6,54
Student 3,4,72,7,59
Student 4,5,78,8,65
Student 5,6,80,8,70
Student 6,7,85,9,76
Student 7,8,88,9,82
Student 8,4,75,7,61
Student 9,6,82,8,72
Student 10,9,92,10,90
Student 11,3,68,6,51
Student 12,8,90,10,86`;

let rows = [];
let columns = [];
let numericColumns = [];
let charts = {};

const titles = {
  dashboard: ["Intelligence Dashboard", "Turn your data into meaningful decisions."],
  analysis: ["Data Analysis Studio", "Explore, understand, and visualize your data."],
  insights: ["AI Insights", "Discover patterns using calculated statistics."],
  prediction: ["Prediction Studio", "Explore simple numerical predictions."],
  reports: ["Reports Center", "Export useful summaries of your dataset."]
};

function parseCSV(text) {
  const result = Papa.parse(text.trim(), {
    header: true,
    skipEmptyLines: true,
    transformHeader: h => h.trim()
  });
  if (result.errors.length) throw new Error("CSV parsing failed. Check your file format.");
  const data = result.data;
  if (!data.length || !result.meta.fields?.length) {
    throw new Error("The CSV file is empty or has no header row.");
  }
  if (result.meta.fields.length > 100) throw new Error("Maximum 100 columns supported.");
  if (data.length > 20000) throw new Error("Maximum 20,000 rows supported in this demo.");
  return { data, fields: result.meta.fields };
}

function numericValues(col) {
  return rows.map(r => {
    const v = String(r[col] ?? "").trim();
    if (v === "") return null;
    const n = Number(v);
    return Number.isFinite(n) ? n : null;
  });
}

function mean(a) {
  return a.length ? a.reduce((s, n) => s + n, 0) / a.length : null;
}

function median(a) {
  if (!a.length) return null;
  const b = [...a].sort((x,y) => x-y);
  const m = Math.floor(b.length/2);
  return b.length % 2 ? b[m] : (b[m-1]+b[m])/2;
}

function fmt(n) {
  return n === null || !Number.isFinite(n) ? "N/A" : Number(n.toFixed(2)).toLocaleString();
}

function getStats(col) {
  const all = numericValues(col);
  const values = all.filter(v => v !== null);
  if (!values.length) return null;
  const avg = mean(values);
  const variance = mean(values.map(v => (v-avg)**2));
  return {
    values, count: values.length,
    missing: all.length-values.length,
    mean: avg,
    median: median(values),
    min: Math.min(...values),
    max: Math.max(...values),
    std: Math.sqrt(variance)
  };
}

function destroyChart(id) {
  if (charts[id]) {
    charts[id].destroy();
    delete charts[id];
  }
}

function makeChart(id, config) {
  destroyChart(id);
  const canvas = document.getElementById(id);
  if (!canvas) return;
  charts[id] = new Chart(canvas, config);
}

function chartColors() {
  return {
    cyan: "#53e5ff",
    purple: "#9d7bff",
    green: "#52e0a0",
    grid: "rgba(150,170,210,0.12)",
    text: "#aebbd5"
  };
}

function baseOptions() {
  const c = chartColors();
  return {
    responsive: true,
    maintainAspectRatio: false,
    plugins: {
      legend: { labels: { color: c.text } }
    },
    scales: {
      x: { ticks: { color: c.text }, grid: { color: c.grid } },
      y: { ticks: { color: c.text }, grid: { color: c.grid } }
    }
  };
}

function initDataset(data, fields) {
  rows = data;
  columns = fields;
  numericColumns = fields.filter(col => {
    const values = numericValues(col);
    return values.some(v => v !== null);
  });

  document.getElementById("recordsMetric").textContent = rows.length;
  document.getElementById("featuresMetric").textContent = columns.length;

  const missing = rows.reduce((sum, row) =>
    sum + columns.filter(col => String(row[col] ?? "").trim() === "").length, 0);

  document.getElementById("missingMetric").textContent = missing;

  renderTable();
  renderSelectors();
  renderOverview();
  renderColumnChart();
  renderInsights();

  document.getElementById("uploadStatus").textContent =
    `Loaded ${rows.length} records and ${columns.length} columns successfully.`;

  document.getElementById("analysisSummary").innerHTML =
    `<div class="insight">Dataset loaded successfully. Click Analyze Dataset to calculate summary statistics.</div>`;
}

function renderTable() {
  const host = document.getElementById("dataTable");
  if (!rows.length) {
    host.textContent = "No dataset loaded.";
    return;
  }

  const shown = rows.slice(0, 100);
  let html = "<table><thead><tr>";
  columns.forEach(c => html += `<th>${escapeHTML(c)}</th>`);
  html += "</tr></thead><tbody>";

  shown.forEach(row => {
    html += "<tr>";
    columns.forEach(c => html += `<td>${escapeHTML(row[c] ?? "")}</td>`);
    html += "</tr>";
  });

  html += "</tbody></table>";
  if (rows.length > 100) {
    html += `<p class="small">Showing 100 of ${rows.length} records.</p>`;
  }
  host.innerHTML = html;
}

function escapeHTML(value) {
  return String(value).replace(/[&<>"']/g, ch => ({
    "&": "&amp;", "<": "&lt;", ">": "&gt;",
    '"': "&quot;", "'": "&#39;"
  })[ch]);
}

function renderSelectors() {
  const selects = ["columnSelect", "xColumn", "yColumn"];
  selects.forEach(id => {
    const select = document.getElementById(id);
    select.innerHTML = "";
    numericColumns.forEach(col => {
      const option = document.createElement("option");
      option.value = col;
      option.textContent = col;
      select.appendChild(option);
    });
  });

  if (numericColumns.length > 1) {
    document.getElementById("xColumn").selectedIndex = 0;
    document.getElementById("yColumn").selectedIndex = 1;
  }
}

function renderOverview() {
  const c = chartColors();
  const col = numericColumns[0];

  if (!col) {
    destroyChart("overviewChart");
    return;
  }

  const stats = getStats(col);
  makeChart("overviewChart", {
    type: "bar",
    data: {
      labels: rows.slice(0, 20).map((r,i) => String(r[columns[0]] || `Row ${i+1}`)),
      datasets: [{
        label: col,
        data: rows.slice(0,20).map(r => {
          const v = Number(r[col]);
          return String(r[col] ?? "").trim() !== "" && Number.isFinite(v) ? v : null;
        }),
        backgroundColor: c.purple,
        borderRadius: 5
      }]
    },
    options: baseOptions()
  });
}

function renderColumnChart() {
  const col = document.getElementById("columnSelect").value;
  if (!col) return;
  const stats = getStats(col);
  if (!stats) return;

  makeChart("columnChart", {
    type: "line",
    data: {
      labels: rows.map((r,i) => i+1).filter((n,i) =>
        String(rows[i][col] ?? "").trim() !== ""),
      datasets: [{
        label: col,
        data: rows.map(r => {
          const v = Number(r[col]);
          return String(r[col] ?? "").trim() !== "" && Number.isFinite(v) ? v : null;
        }),
        borderColor: "#53e5ff",
        backgroundColor: "rgba(83,229,255,0.12)",
        fill: true,
        tension: 0.25,
        spanGaps: true
      }]
    },
    options: baseOptions()
  });
}

function generateInsightsList() {
  const insights = [];
  insights.push(`The dataset contains ${rows.length} records and ${columns.length} columns.`);

  if (!numericColumns.length) {
    insights.push("No numerical columns were detected. Add numeric data to calculate statistical summaries.");
    return insights;
  }

  numericColumns.forEach(col => {
    const s = getStats(col);
    if (!s) return;

    insights.push(
      `${col}: average ${fmt(s.mean)}, median ${fmt(s.median)}, minimum ${fmt(s.min)}, maximum ${fmt(s.max)}.`
    );

    if (s.missing > 0) {
      insights.push(`${col} contains ${s.missing} missing or non-numeric values.`);
    }

    if (s.std === 0) {
      insights.push(`${col} has no variation in its valid numerical values.`);
    }
  });

  const duplicateCount = rows.length - new Set(rows.map(r =>
    JSON.stringify(columns.map(c => r[c]))
  )).size;

  insights.push(`Exact duplicate rows detected: ${duplicateCount}.`);

  return insights;
}

function renderInsights() {
  const insights = generateInsightsList();
  document.getElementById("insightsMetric").textContent = insights.length;

  const html = insights.map(text =>
    `<div class="insight">${escapeHTML(text)}</div>`
  ).join("");

  document.getElementById("dashboardInsights").innerHTML = html;
  document.getElementById("allInsights").innerHTML = html;
}

function analyzeDataset() {
  let html = `<p><strong>Rows:</strong> ${rows.length} &nbsp; <strong>Columns:</strong> ${columns.length}</p>`;
  html += "<div class='table-wrap'><table><thead><tr>";
  html += "<th>Column</th><th>Valid Values</th><th>Missing</th><th>Mean</th><th>Median</th><th>Min</th><th>Max</th><th>Std Dev</th>";
  html += "</tr></thead><tbody>";

  columns.forEach(col => {
    const s = getStats(col);
    const missing = rows.filter(r => String(r[col] ?? "").trim() === "").length;

    html += `<tr><td>${escapeHTML(col)}</td>`;

    if (s) {
      html += `<td>${s.count}</td><td>${s.missing}</td>
        <td>${fmt(s.mean)}</td><td>${fmt(s.median)}</td>
        <td>${fmt(s.min)}</td><td>${fmt(s.max)}</td><td>${fmt(s.std)}</td>`;
    } else {
      html += `<td>0</td><td>${missing}</td><td colspan="5">No numeric statistics available</td>`;
    }
    html += "</tr>";
  });

  html += "</tbody></table></div>";
  document.getElementById("analysisSummary").innerHTML = html;
  renderInsights();
}

function linearRegression(x, y) {
  const n = x.length;
  if (n < 2) throw new Error("At least two valid numeric rows are required.");

  const mx = mean(x), my = mean(y);
  const denom = x.reduce((s,v) => s + (v-mx)**2, 0);

  if (denom === 0) throw new Error("The input feature has no variation.");

  const slope = x.reduce((s,v,i) => s + (v-mx)*(y[i]-my), 0) / denom;
  const intercept = my - slope*mx;

  const predicted = x.map(v => slope*v + intercept);
  const ssRes = y.reduce((s,v,i) => s + (v-predicted[i])**2, 0);
  const ssTot = y.reduce((s,v) => s + (v-my)**2, 0);
  const r2 = ssTot === 0 ? null : 1 - ssRes/ssTot;

  return { slope, intercept, r2, n };
}

function runPrediction() {
  const xCol = document.getElementById("xColumn").value;
  const yCol = document.getElementById("yColumn").value;
  const value = Number(document.getElementById("predictValue").value);
  const host = document.getElementById("predictionResult");

  if (!xCol || !yCol || xCol === yCol) {
    host.innerHTML = `<div class="insight">Select two different numerical columns.</div>`;
    return;
  }

  if (document.getElementById("predictValue").value.trim() === "" || !Number.isFinite(value)) {
    host.innerHTML = `<div class="insight">Enter a valid numeric input value.</div>`;
    return;
  }

  const pairs = rows.map(r => ({
    x: String(r[xCol] ?? "").trim() === "" ? null : Number(r[xCol]),
    y: String(r[yCol] ?? "").trim() === "" ? null : Number(r[yCol])
  })).filter(p => p.x !== null && p.y !== null &&
    Number.isFinite(p.x) && Number.isFinite(p.y));

  try {
    const model = linearRegression(pairs.map(p=>p.x), pairs.map(p=>p.y));
    const prediction = model.slope*value + model.intercept;

    host.innerHTML = `
      <div class="insight">
        <h2>Prediction Result</h2>
        Estimated ${escapeHTML(yCol)}: <strong>${fmt(prediction)}</strong><br>
        Input feature: ${escapeHTML(xCol)} = ${fmt(value)}<br>
        Model: simple linear regression<br>
        Valid training pairs: ${model.n}<br>
        R² on the same fitted data: ${model.r2 === null ? "N/A" : fmt(model.r2)}
        <p class="small">This is an exploratory demo. The displayed R² is calculated on the same data used to fit the line, not on a held-out test set. Results may not generalize.</p>
      </div>`;
  } catch (e) {
    host.innerHTML = `<div class="insight">${escapeHTML(e.message)}</div>`;
  }
}

function downloadFile(filename, content, mime) {
  const blob = new Blob([content], {type:mime});
  const url = URL.createObjectURL(blob);
  const a = document.createElement("a");
  a.href = url;
  a.download = filename;
  document.body.appendChild(a);
  a.click();
  a.remove();
  setTimeout(() => URL.revokeObjectURL(url), 1000);
}

function generateReport() {
  const report = [
    "NEXORA AI - DATA ANALYSIS REPORT",
    "================================",
    `Generated: ${new Date().toLocaleString()}`,
    `Records: ${rows.length}`,
    `Columns: ${columns.length}`,
    "",
    "COLUMN STATISTICS",
    "-----------------",
    ...columns.map(col => {
      const s = getStats(col);
      if (!s) return `${col}: No numerical statistics available.`;
      return `${col}: valid=${s.count}, missing=${s.missing}, mean=${fmt(s.mean)}, median=${fmt(s.median)}, min=${fmt(s.min)}, max=${fmt(s.max)}, std=${fmt(s.std)}`;
    }),
    "",
    "INSIGHTS",
    "--------",
    ...generateInsightsList(),
    "",
    "LIMITATIONS",
    "-----------",
    "Insights are calculated from the current dataset.",
    "Correlation does not prove causation.",
    "Regression predictions are estimates, not guarantees.",
    "This demo does not connect to an external AI model."
  ].join("\n");

  downloadFile("nexora-analysis-report.txt", report, "text/plain;charset=utf-8");
  document.getElementById("reportStatus").innerHTML =
    `<div class="insight">Report generated. Check your device's downloads.</div>`;
}

function exportCSV() {
  if (!rows.length) return;
  downloadFile("nexora-dataset.csv", Papa.unparse(rows), "text/csv;charset=utf-8");
}

document.querySelectorAll(".nav-btn").forEach(btn => {
  btn.addEventListener("click", () => {
    document.querySelectorAll(".nav-btn").forEach(b => b.classList.remove("active"));
    document.querySelectorAll(".section").forEach(s => s.classList.remove("active"));

    btn.classList.add("active");
    document.getElementById(btn.dataset.page).classList.add("active");

    document.getElementById("pageTitle").textContent = titles[btn.dataset.page][0];
    document.getElementById("pageSubtitle").textContent = titles[btn.dataset.page][1];

    Object.values(charts).forEach(chart => chart.resize());
  });
});

document.getElementById("csvFile").addEventListener("change", async event => {
  const file = event.target.files[0];
  if (!file) return;

  const status = document.getElementById("uploadStatus");

  try {
    if (!file.name.toLowerCase().endsWith(".csv")) {
      throw new Error("Please choose a CSV file.");
    }
    if (file.size > 5*1024*1024) {
      throw new Error("File exceeds the 5 MB demo limit.");
    }
    const text = await file.text();
    const parsed = parseCSV(text);
    if (!parsed.fields.length) throw new Error("No columns found.");
    initDataset(parsed.data, parsed.fields);
  } catch (e) {
    status.textContent = e.message || "Could not read the file.";
  }
});

document.getElementById("sampleBtn").addEventListener("click", () => {
  const parsed = parseCSV(sampleCSV);
  initDataset(parsed.data, parsed.fields);
});

document.getElementById("analyzeBtn").addEventListener("click", analyzeDataset);
document.getElementById("generateInsightsBtn").addEventListener("click", renderInsights);
document.getElementById("columnSelect").addEventListener("change", renderColumnChart);
document.getElementById("predictBtn").addEventListener("click", runPrediction);
document.getElementById("reportBtn").addEventListener("click", generateReport);
document.getElementById("downloadCsvBtn").addEventListener("click", exportCSV);

initDataset(parseCSV(sampleCSV).data, parseCSV(sampleCSV).fields);
</script>
</body>
</html>
