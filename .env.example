# Nexora AI — configuration
# Copy this file to .env in the project root and fill in real values.
# app/database.py and app/ai_service.py load these via python-dotenv.

# --- Database ---
# SQLite file path (relative to the project root, where you run uvicorn from)
DATABASE_URL=sqlite:///./nexora.db

# --- AI Service ---
# If LLM_API_KEY is left empty, Nexora AI automatically falls back to the
# local/demo analysis engine and clearly labels all output as such.
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-5

# --- CORS ---
# "*" allows the static frontend/index.html to call the API from any origin
# (file://, a local static server on any port, etc). Restrict this to a
# specific origin if you deploy the frontend somewhere public.
FRONTEND_ORIGIN=*

# --- Server ---
HOST=0.0.0.0
PORT=8000
